# Claude API (analyse des photos)
ANTHROPIC_API_KEY=

# Pixabay (complément Wikimedia) — scripts/find-plant-photos.mjs
PIXABAY_API_KEY=

# Supabase — sync cloud automatique
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Après configuration :
# 1. Exécuter les migrations dans supabase/migrations/
# 2. Activer Auth → Providers → Anonymous sign-ins
# 3. (Optionnel) Désactiver la confirmation e-mail pour les tests
